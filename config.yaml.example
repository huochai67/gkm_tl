llm:
  base_url: "https://api.openai.com/v1"
  api_key: ""
  model: "gpt-4o-mini"
  max_tokens: 4096
  batch_size: 20
  # Adaptive per-batch source character ceiling to prevent max_tokens truncation.
  max_batch_chars: 6000
  max_concurrent: 5
  max_retries: 3
  timeout: 180
  # Low temperature keeps batch output deterministic. Omitted when reasoning_effort is set.
  temperature: 0.2
  # OpenAI-compatible reasoning effort: none, minimal, low, medium, or high.
  reasoning_effort: null
  # Set false to retranslate entries whose source Japanese changed.
  skip_changed: true

paths:
  cache_dir: cache
  server_cache: cache/server
  mod_cache: cache/mod
  nightly_mod_cache: cache/nightly
  gkm_diff: cache/gkm-diff
  output: output

github:
  owner: chinosk6
  repo: GakumasTranslationData
  # Set false to skip downloading and merging the nightly fallback package.
  use_nightly: true
  nightly_url: "https://github.com/huochai67/gkm_tl/releases/download/nightly/GakumasTranslationData.zip"
  diff_owner: vertesan
  diff_repo: gakumasu-diff
  diff_branch: main

character_names:
  amao: 有村麻央
  hski: 花海咲季
  hume: 花海佑芽
  fktn: 藤田琴音
  kllj: 葛城莉莉娅
  hrnm: 姬崎莉波
  shro: 筱泽广
  ssmk: 紫云清夏
  ttmr: 月村手毬
  kcna: 仓本千奈
  hmsz: 秦谷美铃
  atbm: 雨夜燕
  jsna: 十王星南
  nasr: 根绪亚纱里
  krnh: 贺阳燐羽
  trvo: Vo训练员
  trda: Da训练员
  trvi: Vi训练员
  cmmn: ""
  "{user}": "{user}"

